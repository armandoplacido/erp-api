{
  "name": "erp-api",
  "version": "0.0.1",
  "description": "",
  "main": "src/main.ts",
  "scripts": {
    "build": "tsup --tsconfig tsconfig.build.json src/main.ts",
    "start": "node dist/main.cjs",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "prepare": "husky",
    "lint:fix": "eslint src/*.ts --fix",
    "knex": "tsx --env-file=.env --env-file-if-exists=.env.local ./node_modules/knex/bin/cli.js --knexfile knexfile.ts",
    "migrate:make": "pnpm knex migrate:make -x ts",
    "migrate:latest": "pnpm knex migrate:latest",
    "migrate:rollback": "pnpm knex migrate:rollback"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "git-commit-msg-linter": "^5.0.10",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knex": "^3.3.0",
    "lint-staged": "^17.6.0",
    "neostandard": "^0.14.1",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.ts": [
      "npm run lint:fix"
    ]
  },
  "dependencies": {
    "oracledb": "^26.0.0"
  }
}
